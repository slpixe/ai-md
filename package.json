{
  "name": "ai-txt",
  "version": "1.11.0",
  "description": "CLI tool to aggregate files into a single Markdown file",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "ai-md": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "local-run": "pnpm exec tsx src/cli.ts -i demo-folder --show-files",
    "publish:npm": "pnpm publish --access public",
    "publish:jsr": "pnpm exec jsr publish",
    "version": "node scripts/sync-version.js && git add jsr.json src/version.ts",
    "preversion": "pnpm test",
    "version:major": "pnpm version major",
    "version:minor": "pnpm version minor",
    "version:patch": "pnpm version patch"
  },
  "keywords": [
    "cli",
    "aggregate",
    "markdown"
  ],
  "author": "@slpixe",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsr": "^0.14.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "gpt-tokenizer": "^4.0.0",
    "ignore": "^7.0.6",
    "isbinaryfile": "^6.0.0",
    "micromatch": "^4.0.8",
    "winston": "^3.19.0"
  },
  "homepage": "https://github.com/slpixe/ai-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slpixe/ai-md.git"
  },
  "bugs": {
    "url": "https://github.com/slpixe/ai-md/issues"
  },
  "jsr": {
    "name": "@slpixe/ai-md",
    "namespace": "slpixe"
  }
}
